#!/usr/bin/env bash
# перевіряє знімок індексу, тобто рівно те, що піде в коміт (adr/0006)
set -euo pipefail

root=$(git rev-parse --show-toplevel)
# знімок кладемо всередину .git: node шукає node_modules вгору по дереву і
# знаходить теку проєкту без посилань (у Git Bash на Windows ln -s копіює теку)
gitdir=$(git rev-parse --absolute-git-dir)
# node_modules проєкту або вище по дереву (тести хуків живуть у підтеці)
dir=$root
until [ -d "$dir/node_modules" ]; do
  if [ "$(dirname "$dir")" = "$dir" ]; then
    echo "pre-commit: немає node_modules, запустіть npm ci" >&2
    exit 1
  fi
  dir=$(dirname "$dir")
done

snap=$(mktemp -d "$gitdir/civic-snap.XXXXXX")
trap 'rm -rf "$snap"' EXIT
git checkout-index --all --prefix="$snap/"

if ! (cd "$snap" && npm run --silent pre-commit); then
  echo >&2
  echo "pre-commit: коміт відхилено. Виправте (npm run fmt) і знову git add." >&2
  exit 1
fi
