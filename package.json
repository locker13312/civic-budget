{
  "name": "civic-budget",
  "version": "0.1.0",
  "description": "Громадський бюджет міста: подання проєктів, модерація, голосування, підсумки",
  "main": "src/server.js",
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "start": "node src/server.js",
    "fmt": "prettier --write . && eslint --fix .",
    "fmt-check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "types": "tsc -p tsconfig.json",
    "docs": "node scripts/check-docs.js",
    "smoke": "node --test --test-reporter=spec \"test/smoke/*.test.js\"",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "build": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && npm pack --pack-destination dist --silent",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "deps": "knip --no-progress",
    "check": "npm run fmt-check && npm run lint && npm run boundaries && npm run types && npm run deps && npm run docs && npm run test && npm run build",
    "pre-commit": "npm run fmt-check && npm run lint && npm run boundaries && npm run smoke",
    "report": "bash scripts/report.sh",
    "start:static": "node src/server.js --static",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/db.js migrate",
    "db:seed": "node scripts/db.js seed",
    "db:reset": "node scripts/db.js reset",
    "test:unit": "node --test --test-reporter=spec \"test/unit/*.test.js\"",
    "test:integration": "node --test --test-reporter=spec \"test/smoke/*.test.js\" \"test/api/*.test.js\" \"test/db/*.test.js\" \"test/hooks/*.test.js\"",
    "test:e2e": "node --test --test-reporter=spec \"test/e2e/*.test.js\"",
    "coverage": "node --test --test-reporter=spec --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-branches=80 \"test/**/*.test.js\"",
    "coverage:unit": "node --test --test-reporter=spec --experimental-test-coverage --test-coverage-include=\"src/results/domain.js\" --test-coverage-include=\"src/results/service.js\" --test-coverage-include=\"src/results/repository.memory.js\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/unit/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locker13312/civic-budget.git"
  },
  "author": "Литвиненко Ілля <litvinenko7b@gmail.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/locker13312/civic-budget/issues"
  },
  "homepage": "https://github.com/locker13312/civic-budget#readme",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "awilix": "^13.0.5",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "globals": "^17.13.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
